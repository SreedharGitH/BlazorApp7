@page "/docsearch"
@using System.ComponentModel.DataAnnotations
@using System.ComponentModel.DataAnnotations.Schema
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory

<h3>Search Document</h3>

<!-- 1. Insert Form -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">Add New Document</div>
    <div class="card-body">
        <EditForm Model="@newDocument" OnValidSubmit="HandleInsert" FormName="AddDocForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Reference:</label>
                    <InputText @bind-Value="newDocument.Reference" class="form-control" placeholder="e.g. REF-100" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Subject:</label>
                    <InputText @bind-Value="newDocument.Subject" class="form-control" placeholder="e.g. Invoice Approval" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Received Date:</label>
                    <InputDate @bind-Value="newDocument.ReceivedDate" class="form-control" />
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-success">Save Document</button>
            </div>
        </EditForm>
    </div>
</div>

<!-- 2. Existing Table Display -->
@if (documents == null)
{
    <p><em>Loading data from SQL Server...</em></p>
}
else if (!documents.Any())
{
    <p>No document records found in the database.</p>
}
else
{
    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Reference</th>
                <th>Subject</th>
                <th>Received Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var doc in documents)
            {
                <tr>
                    <td>@doc.Reference</td>
                    <td>@doc.Subject</td>
                    <td>@doc.ReceivedDate?.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    // Component State Properties
    private List<DocumentRecord>? documents;

    // Form Binding Property
    private DocumentRecord newDocument = new();

    // Initial load: Fetch all documents
    protected override async Task OnInitializedAsync()
    {
        await FillData();
    }

    // Dynamic Filter Method executed on database level
    private async Task FillData()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        IQueryable<DocumentRecord> query = context.Documents;
        documents = await query.ToListAsync();
    }

    // 3. Handle Form Submission
    private async Task HandleInsert()
    {
        using var context = await DbFactory.CreateDbContextAsync();

        // Add to database context and save changes
        context.Documents.Add(newDocument);
        await context.SaveChangesAsync();

        // Reset the form model for the next input
        newDocument = new() { ReceivedDate = DateTime.Now };

        // Refresh the list to display the newly inserted item
        await FillData();
    }

    [Table("Document")]
    public class DocumentRecord
    {
        [Key]
        [Column("DocumentId")]
        public int DocumentId { get; set; }

        // Use string? to allow NULL values from the ReferenceNo column
        [Column("RefernceNo")]
        public string? Reference { get; set; }

        // Use string? to allow NULL values from the docSubject column
        [Column("docSubject")]
        public string? Subject { get; set; }

        // Use DateTime? to allow NULL values from the DocReceivedDate column
        [Column("DocReceivedDate")]
        public DateTime? ReceivedDate { get; set; } = DateTime.Now; // Default to today
    }

    // Entity Framework Core Context
    public class AppDbContext : DbContext
    {
        public AppDbContext(DbContextOptions<AppDbContext> options) : base(options) { }
        public DbSet<DocumentRecord> Documents { get; set; } = null!;
    }
}
